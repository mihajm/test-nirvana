{
  "name": "test-nirvana",
  "version": "7.22.1",
  "description": "Stay in zen-mode as your code is fully tested",
  "keywords": [
    "cli",
    "numerology",
    "power-versioning",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/mihajm/test-nirvana#readme",
  "bugs": {
    "url": "https://github.com/mihajm/test-nirvana/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihajm/test-nirvana.git"
  },
  "bin": {
    "test-nirvana": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "POWER-VERSIONING.md",
    "SECURITY.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "dev": "tsdown --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "prepack": "bun run check && bun run release:verify && bun run build",
    "release:verify": "node --experimental-strip-types scripts/verify-release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
